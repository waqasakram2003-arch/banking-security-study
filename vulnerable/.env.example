# Copy to backend/.env and fill in. Never commit the real file.
PORT=3000

# Use a LOCAL, THROWAWAY database. This application is deliberately insecure:
# an attacker who reaches it can read and destroy everything in this database.
MONGODB_URI=mongodb://127.0.0.1:27017/banking-vulnerable

# Any value. The point of this build is that the token handling is weak.
JWT_SECRET=replace-me-locally

DEMO_MODE=true
