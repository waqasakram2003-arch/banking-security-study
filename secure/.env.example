# Copy to backend/.env and fill in. Never commit the real file.
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/banking-secure

# Long, random, and unique to this deployment.
JWT_SECRET=replace-with-a-long-random-string

# Optional: transactional mail. Use a provider credential, not a personal mailbox.
MAIL_USER=
MAIL_APP_PASSWORD=
